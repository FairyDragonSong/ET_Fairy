<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwConfigExceptions="true">
  <variable name="logRoot" value="${basedir}/../Logs/bounded/${processid}" />
  <targets>
    <target name="InfoAsync" xsi:type="AsyncWrapper" queueLimit="4096" overflowAction="Block" batchSize="100">
      <target name="InfoFile" xsi:type="File" fileName="${var:logRoot}/info.log"
              archiveFileName="${var:logRoot}/archive/info.{#}.log" archiveAboveSize="67108864" archiveNumbering="Rolling" maxArchiveFiles="4"
              keepFileOpen="true" layout="${longdate}|${level}|${logger}|${message}" />
    </target>
    <target name="WarnAsync" xsi:type="AsyncWrapper" queueLimit="4096" overflowAction="Block" batchSize="100">
      <target name="WarnFile" xsi:type="File" fileName="${var:logRoot}/warn.log"
              archiveFileName="${var:logRoot}/archive/warn.{#}.log" archiveAboveSize="67108864" archiveNumbering="Rolling" maxArchiveFiles="4"
              keepFileOpen="true" layout="${longdate}|${level}|${logger}|${message}" />
    </target>
    <target name="ErrorAsync" xsi:type="AsyncWrapper" queueLimit="4096" overflowAction="Block" batchSize="100">
      <target name="ErrorFile" xsi:type="File" fileName="${var:logRoot}/error.log"
              archiveFileName="${var:logRoot}/archive/error.{#}.log" archiveAboveSize="67108864" archiveNumbering="Rolling" maxArchiveFiles="4"
              keepFileOpen="true" layout="${longdate}|${level}|${logger}|${message}" />
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="InfoAsync" />
    <logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="WarnAsync" />
    <logger name="*" minlevel="Error" writeTo="ErrorAsync" />
  </rules>
</nlog>
